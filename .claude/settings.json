{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(.sdd-locks.json)",
      "Edit(.sdd/state.json)",
      "Edit(.sdd/**)",
      "Edit(logs/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(chmod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.sdd/bin/hooks.py claude-pre-edit",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.sdd/bin/hooks.py claude-pre-read",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.sdd/bin/hooks.py claude-pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.sdd/bin/hooks.py claude-post",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
